lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

#####################
# Glowforge Utilities
# We don't want anyone accidently uploading their machine credentials!
gf-machine-emulator.cfg

# The emulator downloads firmware, logs and pulse files into these
# directories; only the committed fixtures (see examples/_RESOURCES/README.md)
# and the placeholder READMEs belong in the repository.
examples/_RESOURCES/FW/*
!examples/_RESOURCES/FW/README.md
examples/_RESOURCES/LOG/*
!examples/_RESOURCES/LOG/README.md
examples/_RESOURCES/MOTION/*
!examples/_RESOURCES/MOTION/README.md
!examples/_RESOURCES/MOTION/1234567890-nooptions-xxxxx.puls
!examples/_RESOURCES/MOTION/hunt-signed-offset--8-step-size-0.35306.puls
!examples/_RESOURCES/MOTION/motions_xxxxx.puls

# Keep PyCharm users (ScottW, for one) from sharing their IDE settings with everyone.
.idea/

# Freely write scripts starting with "test" or in the dev folder that won't be uploaded to Github
test*
dev/

# The package test suite is tracked (the rule above is for scratch scripts).
!tests/
!tests/*.py
tests/__pycache__/

# The test tree and the host-test workflow are part of the repository.
!tests/
!tests/*.py
!.github/workflows/host-tests.yml
